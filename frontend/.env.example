# ─────────────────────────────────────────────
#  Supabase
# ─────────────────────────────────────────────
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────
#  AI Provider API Keys
# ─────────────────────────────────────────────
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# ─────────────────────────────────────────────
#  AI Model Configuration
#  Available: gpt-4o, gpt-4o-mini, o3-mini,
#             deepseek, deepseek-r1,
#             claude-sonnet, claude-haiku,
#             gemini-2.5-flash, gemini-2.5-pro,
#             minimax-text-01, minimax-m1,
#             minimax-m2.5, minimax-m2.5-highspeed
# ─────────────────────────────────────────────
AI_MODEL=deepseek              # Shared fallback and non-chat default
NORMAL_AI_MODEL=minimax-m2.5   # normal chat only
AGENT_AI_MODEL=gpt-4o          # agent mode only
RESEARCH_AI_MODEL=deepseek     # research mode only

# ─────────────────────────────────────────────
#  Discussion Mode — Per-Panelist Model
# ─────────────────────────────────────────────
DISCUSSION_BULL_MODEL=gpt-4o
DISCUSSION_BEAR_MODEL=deepseek
DISCUSSION_MODERATOR_MODEL=gpt-4o

# ─────────────────────────────────────────────
#  Web Search  (Tavily — https://tavily.com)
# ─────────────────────────────────────────────
TAVILY_API_KEY=
DEEP_RESEARCH_MAX_ITERATIONS=8

# ─────────────────────────────────────────────
#  TradingView MCP (Python FastAPI service)
#  See /Users/iphone/Desktop/tradingview-mcp/
#  Deploy with Railway/Render/Fly, then set:
# ─────────────────────────────────────────────
TRADINGVIEW_MCP_URL=
TRADINGVIEW_MCP_KEY=

# ─────────────────────────────────────────────
#  Dify Workflow PoC
# ─────────────────────────────────────────────
DIFY_BASE_URL=http://localhost:5001/v1
DIFY_AGENT_ENABLED=0
DIFY_AGENT_API_KEY=
DIFY_RESEARCH_ENABLED=0
DIFY_RESEARCH_API_KEY=
DIFY_TIMEOUT_MS=60000

# ─────────────────────────────────────────────
#  Telegram Bot
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_REQUIRE_WEBHOOK_SECRET=0
TELEGRAM_RATE_LIMIT_PER_MINUTE=15

# ─────────────────────────────────────────────
#  Debug
# ─────────────────────────────────────────────
# BIGLOT_CHAT_ECHO_MODE=1
